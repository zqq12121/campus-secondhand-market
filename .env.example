# 复制为 .env 后填写；.env 已在 .gitignore 中，禁止提交
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=campus_trade
MYSQL_USER=root
MYSQL_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 支付：mock 为本地模拟收银台（仅开发）；alipay 为支付宝开放平台（需填写下面三项）；
# disabled 关闭担保交易只允许面交。生产环境（prod profile）禁止 mock，未接支付请用 disabled
PAY_MODE=mock
ALIPAY_APP_ID=
# 应用私钥（PKCS8，单行）与支付宝公钥，均从沙箱控制台获取
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付宝服务器回调地址，需公网可达（本地可用内网穿透）；不可达时由前端轮询 pay-status 主动查询补偿
ALIPAY_NOTIFY_URL=http://localhost:8080/api/pay/alipay/notify
PAY_RETURN_URL=http://localhost:5180/order/{orderId}?from=alipay

# 至少 32 字节的随机串，可用 openssl rand -base64 48 生成
JWT_USER_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ADMIN_SECRET=change-me-to-another-random-string-of-at-least-32-bytes

# 首次启动且库中无管理员时创建超级管理员
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-me

# false 时验证码只打印到后端日志
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/uploads

# 商品搜索引擎：mysql（默认，MySQL ngram 全文索引）/ es（需 docker compose --profile es 启动 Elasticsearch）
SEARCH_ENGINE=mysql
ES_URIS=http://localhost:9200

# docker compose --profile app 部署时：前端端口与浏览器访问的站点地址（图片地址、支付返回地址据此生成）
WEB_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088

# ===== 生产部署（docker-compose.prod.yml，见 docs/上线部署.md） =====
# 站点域名（不带 https://），PUBLIC_BASE_URL 同时改为 https://<DOMAIN>
DOMAIN=
# Let's Encrypt 证书到期提醒邮箱
CERT_EMAIL=

# ===== 校园二手助手（ai-service，Python） =====
# DeepSeek API（OpenAI 兼容），密钥在 DeepSeek 开放平台创建
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# enabled / disabled：工具调用场景默认关闭思考模式
DEEPSEEK_THINKING=disabled
# 备用模型（可选，OpenAI 兼容接口）：模型名和密钥都填才启用，主模型超时 / 429 / 5xx 时自动切换
FALLBACK_MODEL=
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
# ai-service 访问 Java 后端的地址（compose 部署时自动改为 http://backend:8080）
BACKEND_BASE_URL=http://localhost:8080
# 调 Java 连续失败 N 次后熔断 M 秒，熔断期间直接返回「服务暂不可用」；N 填 0 关闭
JAVA_BREAKER_FAILURES=5
JAVA_BREAKER_COOLDOWN_SECONDS=30
# MySQL 只读账号，仅用于同步商品向量索引；创建方法见 ai-service/README.md。留空则只用关键词检索
AI_MYSQL_USER=ai_ro
AI_MYSQL_PASSWORD=change-me
# 本地 embedding 模型（首次启动从 HuggingFace 下载）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
GOODS_SYNC_INTERVAL_SECONDS=120
# 本地重排序模型（首次启动下载约 1.1 GB），留空则不重排
RERANK_MODEL=BAAI/bge-reranker-base
# 外置 text-embeddings-inference（TEI）服务地址，配了就走 HTTP、不在进程内加载对应模型（启动命令见 ai-service/README.md）
EMBEDDING_SERVICE_URL=
RERANK_SERVICE_URL=
# 多实例选主：只有持锁实例跑索引同步
AI_LEADER_LOCK_TTL_SECONDS=30
# 每轮最多工具调用次数；历史超过 MAX 条时压缩为摘要，保留最近 KEEP 条
AI_MAX_TOOL_CALLS=8
AI_HISTORY_MAX_MESSAGES=20
AI_HISTORY_KEEP_MESSAGES=10
AI_SESSION_TTL_DAYS=30
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=100
# 同一会话同时只处理一个请求，锁的兜底过期时间
AI_CONVERSATION_LOCK_TTL_SECONDS=120
# 模型价格（元 / 百万 token），按 DeepSeek 官网价目填写，只用于日志里估算成本；留 0 不计
AI_PRICE_INPUT_PER_M=0
AI_PRICE_OUTPUT_PER_M=0
# 命中上下文缓存的输入单价；不填按 AI_PRICE_INPUT_PER_M 计（不要写成空值）
# AI_PRICE_CACHED_INPUT_PER_M=0
# Langfuse 链路追踪（可选），两个密钥都填才启用。注意：会把对话内容和图片发到 Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 评测（evals/judge.py）的评审模型，留空用 DEEPSEEK_MODEL
AI_EVAL_JUDGE_MODEL=
# MCP Server（python -m app.mcp_server）：stdio / streamable-http；stdio 模式以 AI_MCP_USER_TOKEN 对应的用户身份查询
AI_MCP_TRANSPORT=stdio
AI_MCP_HOST=127.0.0.1
AI_MCP_PORT=8093
AI_MCP_USER_TOKEN=
